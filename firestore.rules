rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isCompany() {
      return isAuthenticated() && (
        request.auth.token.role == 'company' ||
        request.auth.token.role == 'employer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company', 'employer'])
      );
    }

    // Kullanıcı profilleri
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // İş ve Staj İlanları
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isCompany() || isAdmin());
      allow update: if isAuthenticated() && (
        (isCompany() && resource.data.companyId == request.auth.uid) || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (isCompany() && resource.data.companyId == request.auth.uid) || isAdmin()
      );
    }

    // İş / Staj Başvuruları
    match /applications/{applicationId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.companyId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Gönderiler / Feed
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.author.id == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.author.id == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Kulüpler ve Topluluklar
    match /clubs/{clubId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (
        resource.data.presidentId == request.auth.uid ||
        isAdmin()
      );
    }

    // Bildirimler
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Sistem Denetim İzleri (Audit Logs)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Genel Güvenlik Kuralı: Tanımlanmamış koleksiyonlara erişim yalnızca adminlere açık
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
