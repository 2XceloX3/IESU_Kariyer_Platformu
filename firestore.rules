rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.email in ['kariyer@iesu.edu.tr', 'celk386@gmail.com'] && request.auth.token.email_verified == true)
      );
    }

    function isCompany() {
      return isAuthenticated() && (
        request.auth.token.role == 'company' ||
        request.auth.token.role == 'employer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company', 'employer'])
      );
    }

    function isAcademic() {
      return isAuthenticated() && (
        request.auth.token.role == 'academic' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'academic')
      );
    }

    function selfSelectableRole(role) {
      return role in ['student', 'alumni', 'company', 'employer'];
    }

    function noPrivilegedUserFields() {
      return !request.resource.data.keys().hasAny(['isAdmin', 'customClaims', 'claims'])
        && request.resource.data.get('isAdmin', false) == false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && selfSelectableRole(request.resource.data.role)
        && noPrivilegedUserFields();
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && noPrivilegedUserFields()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isAdmin', 'customClaims', 'claims', 'permissions', 'isVerified', 'obsVerified']) 
        );
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isCompany()
          && request.resource.data.companyId == request.auth.uid
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isCompany()
          && resource.data.companyId == request.auth.uid
          && request.resource.data.companyId == resource.data.companyId
        )
      );
      allow delete: if isAuthenticated() && (
        (isCompany() && resource.data.companyId == request.auth.uid) || isAdmin()
      );
    }

    function applicationJobExists() {
      return request.resource.data.jobId is string
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId));
    }

    function applicationCompanyMatchesJob() {
      return applicationJobExists()
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.companyId
          == request.resource.data.companyId;
    }

    function applicantCreateStatusOk() {
      return request.resource.data.status in ['Beklemede', 'Onay Bekliyor'];
    }

    function noCompanyReservedApplicationFields() {
      return !request.resource.data.keys().hasAny([
        'employerDecision', 'companyDecision', 'reviewedBy', 'hired',
        'hiredAt', 'companyInternalStatus', 'adminNotes', 'interviewScore'
      ]);
    }

    match /applications/{applicationId} {
      allow create: if isAuthenticated()
        && request.resource.data.applicantId == request.auth.uid
        && applicationCompanyMatchesJob()
        && applicantCreateStatusOk()
        && noCompanyReservedApplicationFields();

      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin() ||
        isAcademic()
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isCompany()
          && resource.data.companyId == request.auth.uid
          && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.companyId == request.auth.uid
          && request.resource.data.applicantId == resource.data.applicantId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.companyId == resource.data.companyId
        )
      );

      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && (!request.resource.data.keys().hasAny(['authorId']) || request.resource.data.authorId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['author']) || !(request.resource.data.author is map) || !request.resource.data.author.keys().hasAny(['id']) || request.resource.data.author.id == request.auth.uid);
      allow update: if isAuthenticated() && (
        resource.data.author.id == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.author.id == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (
        resource.data.presidentId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests', 'memberRequests', 'members', 'memberCount'])
      );
    }

    match /clubApplications/{appId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    function isValidScrapedFeedDoc() {
      return request.resource.data.keys().hasAll(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 600;
    }

    function isScrapedResource() {
      return resource.data.get('source', '') in ['esenyurt.edu.tr', 'esenyurt.edu.tr (RSS)', 'instagram-graph-api', 'official-fallback', 'live', 'fallback']
        || !resource.data.keys().hasAny(['source']);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isValidScrapedFeedDoc();
      allow delete: if isAdmin() || isScrapedResource();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isValidScrapedFeedDoc();
      allow delete: if isAdmin() || isScrapedResource();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isValidScrapedFeedDoc();
      allow delete: if isAdmin() || isScrapedResource();
    }

    match /social_media/{postId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isValidScrapedFeedDoc();
      allow delete: if isAdmin() || isScrapedResource();
    }

    match /iesuScraperFeed/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(['news', 'events', 'announcements', 'socialMedia', 'lastUpdated', 'source']);
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['userId', 'title'])
        && request.resource.data.userId is string;
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /internships/{internshipId} {
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status in ['Beklemede', 'Onay Bekliyor', 'pending']
        && request.resource.data.get('advisorStatus', 'pending') in ['pending', 'Beklemede']
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']);

      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAcademic() ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isAcademic()
          && request.resource.data.studentId == resource.data.studentId
        )
      );

      allow delete: if isAdmin();
    }

    match /academicApprovals/{docId} {
      allow read, create, update: if isAuthenticated() && (isAcademic() || isAdmin());
      allow delete: if isAdmin();
    }

    match /mentorshipRequests/{docId} {
      allow read: if isAuthenticated() && (
        isAcademic() || isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.applicantId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && (!request.resource.data.keys().hasAny(['studentId']) || request.resource.data.studentId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['applicantId']) || request.resource.data.applicantId == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAcademic() || isAdmin() || (
          resource.data.studentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedBy', 'reviewedBy'])
        )
      );
      allow delete: if isAdmin();
    }

    match /researchLabs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAcademic() || isAdmin());
    }

    match /counselingRequests/{docId} {
      allow read: if isAuthenticated() && (isAcademic() || isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated()
        && (!request.resource.data.keys().hasAny(['studentId']) || request.resource.data.studentId == request.auth.uid);
      allow update: if isAuthenticated() && (isAcademic() || isAdmin());
      allow delete: if isAdmin();
    }

    match /platformData/{sliceKey} {
      allow read: if isAuthenticated() || sliceKey in ['news', 'events', 'announcements', 'socialMedia', 'social_media', 'iesuScraperFeed', 'institutionalStatsData'];
      allow write: if isAdmin() || sliceKey in ['news', 'events', 'announcements', 'socialMedia', 'social_media', 'iesuScraperFeed'];
    }

  match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /internships/{internshipId} {
      allow read: if true;
      allow create: if isAdmin() || isCompany() || isAcademic();
      allow update, delete: if isAdmin() || isAcademic() || (isCompany() && resource.data.companyId == request.auth.uid);
    }
    match /internship_applications/{appId} {
      allow read: if isAdmin() || isAcademic() || (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.applicantId == request.auth.uid || resource.data.companyId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.applicantId == request.auth.uid);
      allow update: if isAdmin() || isAcademic() || (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.companyId == request.auth.uid));
      allow delete: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.recipientId == request.auth.uid);
    }
    match /messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /virtual_fairs/{fairId} {
      allow read: if true;
      allow write: if isAdmin() || isCompany();
    }
    match /fair_booths/{boothId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isCompany() && request.resource.data.companyId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.donorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /verifications/{verificationId} {
      allow read: if isAdmin() || isAcademic() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isAcademic();
    }
    match /accreditations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAcademic();
    }
    match /protocols/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAcademic() || isCompany();
    }
    match /qs_rankings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isAcademic();
    }
    match /company_profiles/{companyId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isCompany() && isOwner(companyId));
      allow delete: if isAdmin();
    }
    match /academic_records/{recordId} {
      allow read: if isAdmin() || isAcademic() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isAdmin() || isAcademic();
    }
    match /alumni_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || hasRole('alumni');
    }
  
match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
