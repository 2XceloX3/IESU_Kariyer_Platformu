230668269801_n.jpg","sourceUrl":"https://www.esenyurt.edu.tr/icerik/3204-kariyer-gelistirme-ofisi-koordinatorlugu-galerimiz","official":true,"category":"Galeri","alt":"TDT Staj Başvuruları","imageBased":true},{"id":"gal-23","title":"Merak Ettikleriniz","image":"assets/official/uploads/2025/07/ung8hhz4h6xjq-504503911_18280939147284654_134701743499588838_n-1.jpg","sourceUrl":"https://www.esenyurt.edu.tr/icerik/3204-kariyer-gelistirme-ofisi-koordinatorlugu-galerimiz","official":true,"category":"Galeri","alt":"Merak Ettikleriniz","imageBased":true},{"id":"gal-24","title":"Kapsül Başvuruları","image":"assets/official/uploads/2025/07/haqv3pm8fkdc6-504511271_18280927366284654_2833474011026813104_n-1.jpg","sourceUrl":"https://www.esenyurt.edu.tr/icerik/3204-kariyer-gelistirme-ofisi-koordinatorlugu-galerimiz","official":true,"category":"Galeri","alt":"Kapsül Başvuruları","imageBased":true}],"campusNews":[{"id":"news-2026-mezuniyet","title":"İstanbul Esenyurt Üniversitesi 2025–2026 Akademik Yılı Mezuniyet Töreni","dateText":"01/07/2026","category":"Haber","text":"2025–2026 akademik yılı mezuniyet töreni büyük katılımla gerçekleşti.","sourceUrl":"https://www.esenyurt.edu.tr/icerik/haberler/2355-kariyer-gelistirme-ofisi-koordinatorlugu","image":"assets/official/events/03-mezuniyet-toreni.jpg"},{"id":"news-kariyer-fest","title":"Gelecek Burada Şekilleniyor: Kariyer Fest ile Vizyoner Bir Günü Geride Bıraktık","dateText":"13/05/2026","category":"Kampüsten Gelişmeler","text":"Kariyer Fest kapsamında öğrenci, mezun ve işveren buluşmaları kampüs içinde görünür hale getirildi.","sourceUrl":"https://www.esenyurt.edu.tr/icerik/haberler/2355-kariyer-gelistirme-ofisi-koordinatorlugu","image":"assets/official/events/04-kariyer-fest-12-mayis.jpeg"},{"id":"news-bahar-senligi","title":"İESU Bahar Şenliği 26’ Başlıyor","dateText":"10/05/2026","category":"Etkinlik Duyurusu","text":"Kampüs yaşamı, kariyer etkinlikleri ve öğrenci katılımı odaklı resmi etkinlik kaydı.","sourceUrl":"https://www.esenyurt.edu.tr/icerik/etkinlikler/2355-kariyer-gelistirme-ofisi-koordinatorlugu","image":"assets/official/events/01-kultur-fest-11-mayis.jpeg"}],"officialMenu":[{"group":"Hakkımızda","items":["Misyon & Vizyon","Biz Kimiz","Ekip Üyeleri","Koordinatörün Mesajı","Kariyer Merkezi Yönergesi","Organizasyon Yapımız","İş Akış Şeması","İletişim"]},{"group":"CV & Mülakat Rehberi","items":["CV Hazırlama Kılavuzu","Özgeçmiş Nasıl Hazırlanmalıdır?"]},{"group":"Kariyer Danışmanlığı","items":["Bireysel Görüşme Randevusu","Online Danışmanlık","Öğrenci Beklenti Anketi","Sıkça Sorulan Sorular","Mülakat Öncesi Hazırlık"]},{"group":"Mezunlar","items":["Mezun Başarı Hikayeleri","Mentorluk Programı","Mezun Takip Sistemi","Mezun Öğrenci Memnuniyet Anketi"]},{"group":"İş ve Staj","items":["İş İlanları","Staj İlanları","T.C. Ulusal Staj Programı","Gönüllü Staj"]},{"group":"Diğer","items":["Formlar ve Belgeler","Yetenek Kapısı","Portal Giriş ve Kullanım Kılavuzu","Sıkça Sorulan Sorular","Öğrenci, Mezun ve İşveren Soruları","Çözüm Ortaklarımız","Galerimiz"]}],"sources":{"main":"https://www.esenyurt.edu.tr/icerik/2355-kariyer-gelistirme-ofisi-koordinatorlugu","events":"https://www.esenyurt.edu.tr/icerik/etkinlikler/2355-kariyer-gelistirme-ofisi-koordinatorlugu","eventsPage2":"https://www.esenyurt.edu.tr/icerik/etkinlikler/2355-kariyer-gelistirme-ofisi-koordinatorlugu?page=2","jobs":"https://www.esenyurt.edu.tr/icerik/2361-kariyer-gelistirme-ofisi-koordinatorlugu-is-ilanlari","internships":"https://www.esenyurt.edu.tr/icerik/2362-kariyer-gelistirme-ofisi-koordinatorlugu-staj-ilanlari","gallery":"https://www.esenyurt.edu.tr/icerik/3204-kariyer-gelistirme-ofisi-koordinatorlugu-galerimiz","news":"https://www.esenyurt.edu.tr/icerik/haberler/2355-kariyer-gelistirme-ofisi-koordinatorlugu","announcements":"https://www.esenyurt.edu.tr/icerik/duyurular/2355-kariyer-gelistirme-ofisi-koordinatorlugu","obs":"https://obs.esenyurt.edu.tr/","home":"https://www.esenyurt.edu.tr/","candidate":"https://aday.esenyurt.edu.tr/"},"metadata":{"generatedAt":"2026-07-04T15:00:00+03:00","sourcePolicy":"Resmi esenyurt.edu.tr kariyer merkezi sayfaları ve yerel resmi görsel varlıklar kullanıldı.","pageUpdates":{"jobs":"13/04/2026","internships":"19/06/2026","gallery":"08/07/2025","events":"26 resmi etkinlik, iki sayfa"}}};
  var TARGETS={'/jobs':1,'/events':1,'/announcements':1,'/gallery':1,'/about':1,'/contact':1};
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function route(){
    var h=(location.hash||'').replace(/^#/,'').split('?')[0];
    if(TARGETS[h]) return h;
    var p=(location.pathname||'/').replace(/\/g,'/');
    var part=p.split('/').filter(Boolean).pop()||'';
    if(/\.html?$/i.test(part)) return '/';
    p='/' + part.toLowerCase();
    return TARGETS[p]?p:'/';
  }
  function main(){return document.querySelector('#root main')||document.querySelector('main');}
  function imgTag(item,title){var src=item.image||item.imageUrl||'';return src?'<img loading="lazy" decoding="async" src="'+esc(src)+'" alt="'+esc(title||item.title||'İESÜ görseli')+'">':'';}
  function link(item,text){var url=item.sourceUrl||item.detailUrl||item.url||'';return url?'<a href="'+esc(url)+'" target="_blank" rel="noreferrer">'+esc(text||'Resmi kaynağı aç')+'</a>':'';}
  function card(item,kind){
    var title=item.title||item.alt||'Resmi İESÜ Kaydı';
    var meta=item.dateText||item.date||item.timeText||item.category||kind||'';
    var desc=item.text||item.summary||item.status||item.audience||item.alt||item.description||'';
    return '<article class="iesu-panel-only-card">'+imgTag(item,title)+'<div class="iesu-panel-only-card-body"><div class="iesu-panel-only-meta"><span class="iesu-panel-only-chip">'+esc(kind||item.category||'Resmi')+'</span><span>'+esc(meta)+'</span></div><h2>'+esc(title)+'</h2>'+(desc?'<p>'+esc(desc)+'</p>':'')+link(item,'İncele')+'</div></article>';
  }
  function shell(title,desc,count,body,badge){
    return '<main class="iesu-panel-only-page"><section class="iesu-panel-only-hero"><small>'+esc(badge||'İESÜ KARİYER PORTALI')+'</small><h1>'+esc(title)+'</h1><p>'+esc(desc)+'</p></section><div class="iesu-panel-only-toolbar"><strong>'+esc(count)+' kayıt listeleniyor</strong><span>Kaynak: 28 MB çalışma dosyasındaki resmi içerik verisi</span></div>'+body+'</main>';
  }
  function jobs(){var items=(DATA.jobs||[]).concat(DATA.internships||[]);return shell('İş İlanları','Bu alandaki eski örnek ilanlar kaldırıldı. Panel, 28 MB kaynak dosyadaki resmi iş ve staj afişleriyle dolduruldu.',items.length,'<section class="iesu-panel-only-grid">'+items.map(function(x){return card(x,x.category||'İlan');}).join('')+'</section>','İŞ VE STAJ İLANLARI');}
  function events(){var items=DATA.events||[];return shell('Etkinlikler','Bu alandaki eski örnek etkinlikler kaldırıldı. Panel, resmi etkinlik afişleri ve tarih bilgileriyle dolduruldu.',items.length,'<section class="iesu-panel-only-grid">'+items.map(function(x){return card(x,'Etkinlik');}).join('')+'</section>','ETKİNLİKLER');}
  function announcements(){var items=(DATA.campusNews||[]).concat((DATA.events||[]).slice(0,6));return shell('Duyurular','Bu alandaki eski örnek duyurular kaldırıldı. Panel, 28 MB kaynak dosyadaki haber, duyuru ve etkinlik kayıtlarıyla dolduruldu.',items.length,'<section class="iesu-panel-only-grid">'+items.map(function(x){return card(x,x.category||'Duyuru');}).join('')+'</section>','DUYURULAR');}
  function gallery(){var items=DATA.gallery||[];return shell('Galeri','Bu alandaki eski galeri verileri kaldırıldı. Panel, resmi galeri görselleriyle dolduruldu.',items.length,'<section class="iesu-panel-only-grid iesu-panel-only-gallery">'+items.map(function(x){return card(x,'Galeri');}).join('')+'</section>','GALERİ');}
  function about(){var groups=DATA.officialMenu||[];var body='<section class="iesu-panel-only-list">'+groups.map(function(g){return '<article class="iesu-panel-only-info"><h3>'+esc(g.group||'Bilgi')+'</h3><ul>'+((g.items||[]).map(function(i){return '<li>'+esc(i)+'</li>';}).join(''))+'</ul></article>';}).join('')+'</section>';return shell('Hakkımızda','Bu alandaki eski örnek metinler kaldırıldı. Panel, 28 MB kaynak dosyadaki resmi menü ve bilgi başlıklarıyla dolduruldu.',groups.length,body,'HAKKIMIZDA');}
  function contactHTML(){
    var groups=DATA.officialMenu||[];var contact=(groups.filter(function(g){return /iletişim|iletisim/i.test(g.group||'');})[0]||{items:['Kariyer Geliştirme Ofisi Koordinatörlüğü','İş birlikleri ve kariyer danışmanlığı','Öğrenci, mezun ve firma destek süreçleri']});
    var body='<section class="iesu-panel-only-contact"><article class="iesu-panel-only-info"><h3>İletişim</h3><ul>'+((contact.items||[]).map(function(i){return '<li>'+esc(i)+'</li>';}).join(''))+'</ul></article><article class="iesu-panel-only-info"><h3>Kariyer Geliştirme Ofisi</h3><p>İş birliği, staj, iş ilanı, etkinlik ve öğrenci kariyer danışmanlığı talepleri için ilgili birimlere yönlendirme yapılır.</p></article></section>';
    return shell('İletişim','Bu alandaki eski iletişim metinleri kaldırıldı. Panel, 28 MB kaynak dosyadaki resmi iletişim başlıklarıyla dolduruldu.',(contact.items||[]).length,body,'İLETİŞİM');
  }
  function renderContactSection(){
    var sec=document.getElementById('contact');
    if(!sec || sec.getAttribute('data-iesu-panel-filled')==='contact') return;
    sec.setAttribute('data-iesu-panel-filled','contact');
    sec.innerHTML='<div class="iesu-panel-only-page" style="padding-top:0;padding-bottom:0"><section class="iesu-panel-only-hero"><small>İLETİŞİM</small><h1>İletişim</h1><p>28 MB kaynak dosyadaki iletişim ve resmi bilgi başlıkları bu alana taşındı.</p></section>'+contactHTML().replace(/^<main class="iesu-panel-only-page">|<\/main>$/g,'')+'</div>';
  }
  function render(){
    var r=route();
    if(r==='/contact'){var m=main(); if(m) m.outerHTML=contactHTML(); return;}
    if(r==='/'){renderContactSection(); return;}
    if(!TARGETS[r]) return;
    var m=main(); if(!m) return;
    if(m.getAttribute('data-iesu-panel-route')===r) return;
    var html=r==='/jobs'?jobs():r==='/events'?events():r==='/announcements'?announcements():r==='/gallery'?gallery():r==='/about'?about():'';
    if(html){m.outerHTML=html; var nm=main(); if(nm) nm.setAttribute('data-iesu-panel-route',r);}
  }
  function schedule(){setTimeout(render,80);setTimeout(render,280);}
  ['pushState','replaceState'].forEach(function(n){var o=history[n];history[n]=function(){var v=o.apply(this,arguments);schedule();return v;};});
  window.addEventListener('popstate',schedule);window.addEventListener('hashchange',schedule);
  document.addEventListener('click',function(e){var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;if(a) schedule();},true);
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',schedule);else schedule();
})();
</script>
</body>
</html>
