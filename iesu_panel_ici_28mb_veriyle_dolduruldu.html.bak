  </head>
  <body>
    <div id="root"></div>
  <style id="iesu-panel-only-content-css">
  .iesu-panel-only-page{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:42px 0 64px;color:var(--ink,#111827)}
  .iesu-panel-only-hero{border:1px solid var(--line,#e5e7eb);background:linear-gradient(135deg,#fff,#fff7f7);border-radius:24px;padding:28px;margin-bottom:22px;box-shadow:0 18px 48px rgba(15,23,42,.07)}
  .iesu-panel-only-hero small{display:inline-flex;border:1px solid #fecaca;background:#fff;color:var(--brand,#b91c1c);border-radius:999px;padding:6px 11px;font-weight:800;margin-bottom:10px}
  .iesu-panel-only-hero h1{margin:0 0 8px;color:var(--brand-dark,#7f1d1d);font-size:clamp(28px,4vw,46px);line-height:1.08;letter-spacing:-.03em}
  .iesu-panel-only-hero p{margin:0;color:var(--muted,#64748b);max-width:820px;line-height:1.65;font-size:16px}
  .iesu-panel-only-toolbar{display:flex;justify-content:space-between;gap:14px;align-items:center;flex-wrap:wrap;margin:0 0 18px}
  .iesu-panel-only-toolbar strong{color:var(--brand-dark,#7f1d1d)}
  .iesu-panel-only-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:18px}
  .iesu-panel-only-card{border:1px solid var(--line,#e5e7eb);background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 12px 34px rgba(15,23,42,.075)}
  .iesu-panel-only-card img{width:100%;height:220px;object-fit:cover;display:block;background:#f8fafc}
  .iesu-panel-only-card-body{padding:17px;display:grid;gap:9px}
  .iesu-panel-only-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;color:var(--muted,#64748b);font-size:13px}
  .iesu-panel-only-chip{display:inline-flex;border:1px solid #fecaca;background:#fff7f7;color:var(--brand,#b91c1c);border-radius:999px;padding:4px 9px;font-weight:800}
  .iesu-panel-only-card h2,.iesu-panel-only-card h3{margin:0;color:var(--ink,#111827);font-size:18px;line-height:1.25}
  .iesu-panel-only-card p{margin:0;color:var(--muted,#64748b);line-height:1.55}
  .iesu-panel-only-card a{color:var(--brand,#b91c1c);font-weight:800;text-decoration:none}
  .iesu-panel-only-gallery{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
  .iesu-panel-only-gallery .iesu-panel-only-card img{height:185px}
  .iesu-panel-only-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
  .iesu-panel-only-info{border:1px solid var(--line,#e5e7eb);background:#fff;border-radius:18px;padding:18px;box-shadow:0 10px 28px rgba(15,23,42,.055)}
  .iesu-panel-only-info h3{margin:0 0 8px;color:var(--brand-dark,#7f1d1d)}
  .iesu-panel-only-info ul{margin:0;padding-left:18px;color:var(--muted,#64748b);line-height:1.75}
  .iesu-panel-only-contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
  @media(max-width:720px){.iesu-panel-only-page{width:min(100% - 20px,1180px);padding:28px 0 44px}.iesu-panel-only-card img{height:190px}.iesu-panel-only-gallery .iesu-panel-only-card img{height:170px}}
</style>
